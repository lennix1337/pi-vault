{
  "name": "@lennix1337/pi-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Use credentials without the model seeing them: named secrets injected into a child process only, with redaction of tool results and refusal of literal secrets in tool arguments.",
  "author": "lennix1337",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "secrets", "credentials", "dpapi", "credential-manager"],
  "pi": { "extensions": ["./src/index.ts"], "skills": ["./skills"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "vault": "node --import tsx src/cli.ts"
  },
  "dependencies": { "typebox": "1.3.27" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=1.4.0" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=24.2.0" }
}
